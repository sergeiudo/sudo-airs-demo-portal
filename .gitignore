# `.env` alone did not cover the copies people actually make — .env.bak,
# .env.save, .env.2026-09-14 — each a complete set of credentials sitting in the
# tree of a PUBLIC repo. Match the whole family and re-admit the one file that
# must stay tracked.
.env*
!.env.example
*.local
.DS_Store
airs-docs-pdfs/
airs-model-scanner-main/
CLAUDE.md
__pycache__/
*.pyc
.claude/hooks/security.log
docs/claude code hooks.png
excalidraw.log
*.excalidraw

# AWS Chatbot Red Team Target
aws-chatbot-target/

# MCP server venv
mcp-server/.venv/

# Slack release-notes notifier venv + log
.venv-slack-notify/
airs-slack-notify.log

# Superpowers brainstorming sessions
.superpowers/
docs/superpowers/*
!docs/superpowers/specs/
!docs/superpowers/plans/

traces.db
traces.db-shm
traces.db-wal
portkey-old-workspace-backup.json

# Installed skills (anthropics/skills)
.agents/

# Ministry of Health demo — generated at runtime
moh-replay.json
moh-probe-results.json

# Cloud credentials. This repo is PUBLIC, and a downloaded GCP service-account
# key lands in the working tree with a name nothing else matches — one
# `git add -A` would publish a live private key permanently. The patterns are
# specific rather than a blanket *.json so package.json and friends still track.
sergei-playground-*.json
*-service-account*.json
*service_account*.json
gcp-*-key.json
# WIF credential configs hold no secret, but they name internal project/role
# paths and belong on the host, not in git.
*-wif-*.json
vertex-wif*.json
